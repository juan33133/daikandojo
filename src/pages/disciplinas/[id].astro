---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

import disciplinas from "../../data/disciplinas.json";
import horarios from "../../data/horarios.json";

export function getStaticPaths() {
  return disciplinas
    .filter((d) => d.activo !== false)
    .map((d) => ({ params: { id: d.id } }));
}

const { id } = Astro.params;
const current = disciplinas.find((d) => d.id === id)!;
const activeDisciplinas = disciplinas.filter((d) => d.activo !== false);

// Mapeo de ID de disciplina a nombres de actividad en el horario
const disciplinaToActividades: Record<string, string[]> = {
  "aikido-tomiki": ["Aikido"],
  boxeo: ["Boxeo", "Kick Boxing / Boxeo"],
  "brazilian-jiu-jitsu": ["BJJ (Jiu Jitsu)", "Jiu Jitsu"],
  bujinkan: ["Budo Taijutsu"],
  hapkido: ["Hapkido"],
  "ju-jutsu": ["Jiu Jitsu"],
  "karate-do": ["Karate"],
  kenjutsu: ["Kenjutsu"],
  "kick-boxing-k1": ["Kick Boxing", "Kick Boxing / Boxeo"],
  "krav-maga": ["Krav Maga"],
  lucha: ["Lucha"],
  "muay-thai": ["Muay Thai"],
  "tang-soo-do": ["Tang Soo Do"],
};

// Función para obtener clases de una disciplina
function getClasesForDisciplina(disciplinaId: string) {
  const actividadesBuscadas = disciplinaToActividades[disciplinaId] || [];
  type Clase = {
    inicio: string;
    fin: string;
    actividad: string;
    grupo: string;
  };
  type ClaseFiltrada = Clase & { dia: string; nombreMostrar: string };

  const diasSemana = [
    "lunes",
    "martes",
    "miercoles",
    "jueves",
    "viernes",
  ] as const;
  const diasNombres: Record<string, string> = {
    lunes: "Lun",
    martes: "Mar",
    miercoles: "Mié",
    jueves: "Jue",
    viernes: "Vie",
  };

  const clasesFiltradas: ClaseFiltrada[] = [];
  const disciplina = disciplinas.find((d) => d.id === disciplinaId);

  diasSemana.forEach((dia) => {
    const clasesDelDia =
      (horarios.horario_semanal as Record<string, Clase[]>)[dia] || [];
    clasesDelDia.forEach((clase) => {
      const coincide = actividadesBuscadas.some(
        (act) => clase.actividad === act || clase.actividad.includes(act),
      );
      if (coincide && disciplina) {
        clasesFiltradas.push({
          ...clase,
          dia,
          nombreMostrar: disciplina.nombre,
        });
      }
    });
  });

  const clasesPorDiaYHora: Record<string, ClaseFiltrada[]> = {};
  clasesFiltradas.forEach((clase) => {
    const key = `${clase.dia}-${clase.inicio}`;
    if (!clasesPorDiaYHora[key]) clasesPorDiaYHora[key] = [];
    clasesPorDiaYHora[key].push(clase);
  });

  const franjasUnicas = [
    ...new Set(clasesFiltradas.map((c) => c.inicio)),
  ].sort();

  return {
    tieneClases: clasesFiltradas.length > 0,
    clasesPorDiaYHora,
    franjasUnicas,
    diasSemana,
    diasNombres,
  };
}
---

<BaseLayout
  title={`${current.nombre} - Clases en Málaga`}
  description={current.descripcion || `Clases de ${current.nombre} en Daikan Dojo, Málaga. Consulta horarios y únete a nuestra escuela de artes marciales.`}
>
  <Header slot="header" currentPath="/disciplinas" />

  <div class="disciplines-page">
    <!-- ========== CARRUSEL SUPERIOR (Avatares) ========== -->
    <nav class="disc-nav" aria-label="Selector de disciplinas" id="disc-nav">
      {
        activeDisciplinas.map((disc) => (
          <button
            type="button"
            class:list={[
              "disc-nav__btn",
              { active: disc.id === id },
            ]}
            data-discipline-id={disc.id}
            aria-pressed={disc.id === id ? "true" : "false"}
          >
            <img
              class="disc-nav__avatar"
              src={disc.imagen}
              alt={`Icono de ${disc.nombre}`}
              loading="lazy"
              width="72"
              height="72"
            />
            <span class="disc-nav__label">{disc.nombre}</span>
          </button>
        ))
      }
    </nav>

    <!-- ========== CONTENIDO PRINCIPAL ========== -->
    <main class="content">
      {
        activeDisciplinas.map((disc) => {
          const clasesData = getClasesForDisciplina(disc.id);
          const isActive = disc.id === id;

          return (
            <div
              class:list={[
                "disc-panel",
                { "disc-panel--active": isActive },
              ]}
              data-discipline-id={disc.id}
              style={`--accent: ${disc.color}`}
            >
              <h1 class="disc-title">{disc.nombre}</h1>

              <div class="disc-body">
                <div class="disc-info">
                  <p class="disc-desc">{disc.descripcion || ""}</p>
                </div>

                <div class="disc-schedule">
                  {clasesData.tieneClases ? (
                    <div class="schedule-section">
                      <h3>📅 Horario Semanal</h3>
                      <div class="schedule-table-wrapper">
                        <table class="schedule-table">
                          <thead>
                            <tr>
                              <th>Hora</th>
                              {clasesData.diasSemana.map((dia) => (
                                <th>{clasesData.diasNombres[dia]}</th>
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {clasesData.franjasUnicas.map((franja) => (
                              <tr>
                                <td class="schedule-time">{franja}</td>
                                {clasesData.diasSemana.map((dia) => {
                                  const clases =
                                    clasesData.clasesPorDiaYHora[
                                      `${dia}-${franja}`
                                    ] || [];
                                  return (
                                    <td
                                      class={
                                        clases.length > 0
                                          ? "schedule-cell schedule-cell--active"
                                          : "schedule-cell"
                                      }
                                    >
                                      {clases.map((clase) => (
                                        <div
                                          class="schedule-class"
                                          style={`--accent: ${disc.color}`}
                                        >
                                          <span class="schedule-class__name">
                                            {clase.nombreMostrar}
                                          </span>
                                          <span class="schedule-class__group">
                                            {clase.grupo}
                                          </span>
                                          <span class="schedule-class__time">
                                            {clase.inicio}-{clase.fin}
                                          </span>
                                        </div>
                                      ))}
                                    </td>
                                  );
                                })}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                      <p class="schedule-note">
                        <a href="/horarios">Ver horario completo →</a>
                      </p>
                    </div>
                  ) : (
                    <div class="schedule-section schedule-section--empty">
                      <h3>📅 Horario Semanal</h3>
                      <p>
                        Actualmente no hay clases programadas para esta
                        disciplina. <a href="/contacto">Contáctanos</a> para más
                        información.
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* ===========================================
     DISCIPLINAS - Layout Principal
     =========================================== */
  .disciplines-page {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-height));
    margin-top: var(--header-height);
  }

  /* ===========================================
     CARRUSEL SUPERIOR — Avatares + Scroll
     =========================================== */
  .disc-nav {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4);
    background: var(--color-bg-alt);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    position: sticky;
    top: var(--header-height, 70px);
    z-index: 50;

    /* Scroll horizontal táctil (mobile-first) */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;

    /* Ocultar barra de scroll visual */
    scrollbar-width: none;
  }
  .disc-nav::-webkit-scrollbar {
    display: none;
  }

  /* ---- Botón de disciplina ---- */
  .disc-nav__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
    min-width: 76px;
    padding: var(--space-2) var(--space-2);
    background: transparent;
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base);
    scroll-snap-align: center;
  }
  .disc-nav__btn:hover {
    opacity: 0.8;
    background: rgba(255, 255, 255, 0.04);
  }
  .disc-nav__btn.active {
    opacity: 1;
    transform: scale(1.05);
    border-color: var(--color-primary-dark);
    background: rgba(196, 30, 58, 0.1);
  }

  /* ---- Avatar circular ---- */
  .disc-nav__avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid transparent;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }
  .disc-nav__btn.active .disc-nav__avatar {
    border-color: var(--color-primary);
    box-shadow: 0 0 12px rgba(196, 30, 58, 0.45);
  }

  /* ---- Label ---- */
  .disc-nav__label {
    font-family: var(--font-family);
    font-size: 0.68rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color var(--transition-fast);
    text-align: center;
    max-width: 76px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .disc-nav__btn.active .disc-nav__label {
    color: var(--color-text);
  }

  /* ===========================================
     CONTENIDO PRINCIPAL
     =========================================== */
  .disciplines-page .content {
    flex: 1;
    padding: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  /* ---- Panel de disciplina (solo uno visible) ---- */
  .disciplines-page .disc-panel {
    display: none;
    opacity: 0;
  }
  .disciplines-page .disc-panel--active {
    display: block;
    opacity: 1;
  }
  /* Animación solo aplicada via JS (no en carga inicial) */
  .disciplines-page .disc-panel--animate {
    animation: discFadeIn 0.4s ease forwards;
  }

  @keyframes discFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---- Título Hero-style ---- */
  .disc-title {
    font-family: "Black Ops One", var(--font-family-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    color: var(--accent, var(--color-text));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.5);
    margin-bottom: var(--space-6);
  }

  /* ---- Descripción standalone ---- */
  .disc-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    max-width: 55ch;
    margin-bottom: var(--space-6);
  }

  /* ---- Grid cuerpo: info + horario ---- */
  .disc-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* ===========================================
     HORARIO (SCHEDULE)
     =========================================== */
  .schedule-section {
    padding: var(--space-5);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .schedule-section h3 {
    font-size: var(--font-size-base);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .schedule-section--empty p {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
  .schedule-section--empty a {
    color: var(--color-primary);
  }

  .schedule-table-wrapper {
    overflow-x: auto;
    margin-bottom: var(--space-3);
  }
  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
  }
  .schedule-table th,
  .schedule-table td {
    padding: var(--space-2);
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .schedule-table th {
    background: rgba(255, 255, 255, 0.05);
    font-weight: 600;
    color: var(--color-text);
  }
  .schedule-time {
    font-weight: 500;
    color: var(--color-text-muted);
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.02);
  }
  .schedule-cell {
    min-width: 70px;
    vertical-align: top;
  }
  .schedule-cell--active {
    background: rgba(255, 255, 255, 0.03);
  }
  .schedule-class {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.4rem;
    background: rgba(var(--accent, 200, 100, 50), 0.15);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    margin: 2px 0;
  }
  .schedule-class__name {
    font-weight: 600;
    font-size: 0.7rem;
    color: var(--accent);
  }
  .schedule-class__group {
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .schedule-class__time {
    font-size: 0.6rem;
    color: var(--color-text-muted);
    opacity: 0.8;
  }
  .schedule-note {
    text-align: right;
    margin: 0;
  }
  .schedule-note a {
    font-size: 0.8rem;
    color: var(--color-primary);
    text-decoration: none;
  }
  .schedule-note a:hover {
    text-decoration: underline;
  }

  /* ===========================================
     DESKTOP (≥ 768px)
     =========================================== */
  @media (min-width: 768px) {
    .disc-nav {
      justify-content: center;
      overflow-x: visible;
      gap: var(--space-4);
      padding: var(--space-5) var(--space-6);
    }

    .disc-nav__btn {
      min-width: 90px;
      padding: var(--space-3);
    }

    .disc-nav__avatar {
      width: 72px;
      height: 72px;
    }

    .disc-nav__label {
      font-size: var(--font-size-xs);
      max-width: 90px;
    }

    .disciplines-page .content {
      padding: var(--space-8) var(--space-6);
      max-width: 1100px;
    }

    .disc-title {
      font-size: var(--font-size-5xl);
    }

    /* Grid: info izquierda, horario derecha */
    .disc-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .disc-desc {
      margin-bottom: 0;
    }
  }

  /* ===========================================
     LARGE DESKTOP (≥ 1024px)
     =========================================== */
  @media (min-width: 1024px) {
    .disc-nav__avatar {
      width: 80px;
      height: 80px;
    }

    .disc-nav__btn {
      min-width: 100px;
    }

    .disc-nav__label {
      font-size: var(--font-size-sm);
      max-width: 100px;
    }

    .disciplines-page .content {
      max-width: 1200px;
    }
  }

  /* ===========================================
     MOBILE (< 768px)
     =========================================== */
  @media (max-width: 767px) {
    .disciplines-page .content {
      padding: var(--space-4);
    }

    .disc-title {
      font-size: var(--font-size-3xl);
      text-align: center;
    }

    .disc-desc {
      text-align: center;
      max-width: 100%;
    }
  }
</style>

<script is:inline>
  /**
   * Interactividad del carrusel de disciplinas.
   * Vanilla JS — sin dependencias, sin recarga de página.
   */
  document.addEventListener("DOMContentLoaded", function () {
    var nav = document.getElementById("disc-nav");
    var buttons = document.querySelectorAll(".disc-nav__btn");
    var panels = document.querySelectorAll(".disc-panel");

    if (!nav || buttons.length === 0 || panels.length === 0) return;

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var targetId = btn.dataset.disciplineId;
        if (!targetId) return;

        // — Actualizar botones activos —
        buttons.forEach(function (b) {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");

        // — Scroll para centrar el botón en la vista —
        btn.scrollIntoView({
          behavior: "smooth",
          inline: "center",
          block: "nearest",
        });

        // — Cambiar panel visible —
        panels.forEach(function (panel) {
          panel.classList.remove("disc-panel--active");
          panel.classList.remove("disc-panel--animate");
        });

        var targetPanel = document.querySelector(
          '.disc-panel[data-discipline-id="' + targetId + '"]'
        );
        if (targetPanel) {
          // Forzar re-render de la animación CSS
          void targetPanel.offsetWidth;
          targetPanel.classList.add("disc-panel--active");
          targetPanel.classList.add("disc-panel--animate");
        }

        // — Actualizar URL sin recargar la página —
        history.replaceState(null, "", "/disciplinas/" + targetId);
      });
    });

    // — Scroll inicial para centrar el botón activo —
    var activeBtn = nav.querySelector(".disc-nav__btn.active");
    if (activeBtn) {
      // Usar setTimeout para que el DOM esté completamente renderizado
      setTimeout(function () {
        activeBtn.scrollIntoView({
          behavior: "instant",
          inline: "center",
          block: "nearest",
        });
      }, 50);
    }
  });
</script>

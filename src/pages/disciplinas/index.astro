---
import disciplinas from "../../data/disciplinas.json";

// Obtener la primera disciplina activa para la redirección
const firstDiscipline = disciplinas.find((d) => d.activo !== false);
const redirectUrl = firstDiscipline
    ? `/disciplinas/${firstDiscipline.id}`
    : "/";
---

<meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />

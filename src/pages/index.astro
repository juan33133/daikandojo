---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import DisciplineCard from "../components/DisciplineCard.astro";
import disciplinas from "../data/disciplinas.json";
---

<BaseLayout
  title="Inicio"
  description="Daikan Dojo - Escuela de Artes Marciales y Deportes de Contacto en Málaga. Más de 14 disciplinas para todas las edades."
>
  <Header slot="header" currentPath="/" transparent={true} />

  <div id="mobile-fixed-bg"></div>

  <!-- Hero Section -->
  <Hero
    title="<span>Daikan</span> Dojo"
    size="fullscreen"
    slidingSvgMobile="/images/recursos/paredMovil.svg"
  />

  <!-- Disciplinas Section -->
  <section class="section-disciplinas">
    <div class="container">
      <div class="section-header section-header--center">
        <a href="/disciplinas" class="btn-disciplinas">
          <h2 class="section-header__title">Disciplinas</h2>
        </a>
        <div class="divider divider--center"></div>
      </div>

      <div class="carousel-wrapper">
        <button class="carousel-btn carousel-btn--prev" aria-label="Anterior">
          &#10094;
        </button>

        <div class="carousel-track-container">
          <ul class="carousel-track">
            {
              disciplinas
                .filter((disc) => disc.activo !== false)
                .map((disc) => (
                  <li class="carousel-slide">
                    <DisciplineCard
                      id={disc.id}
                      nombre={disc.nombre}
                      imagen={disc.imagen}
                      color={disc.color}
                    />
                  </li>
                ))
            }
          </ul>
        </div>

        <button class="carousel-btn carousel-btn--next" aria-label="Siguiente">
          &#10095;
        </button>
      </div>
    </div>
  </section>

  <!-- Visita Virtual 360° -->
  <section class="viewer-section">
    <div class="container">
      <div class="viewer-grid">
        <div class="viewer-content">
          <h2>Visita <span>Virtual 360°</span></h2>
          <p>
            Conoce nuestras instalaciones desde cualquier lugar. Explora el
            dojo, las zonas de entrenamiento y descubre el ambiente único de
            Daikan.
          </p>
          <div class="mini-cube-container">
            <div class="mini-cube">
              <div class="mini-cube__face mini-cube__face--front">大</div>
              <div class="mini-cube__face mini-cube__face--back">道</div>
              <div class="mini-cube__face mini-cube__face--right">館</div>
              <div class="mini-cube__face mini-cube__face--left">場</div>
              <div class="mini-cube__face mini-cube__face--top">武</div>
              <div class="mini-cube__face mini-cube__face--bottom">術</div>
            </div>
          </div>
        </div>
        <div class="viewer-360">
          <iframe
            src="https://momento360.com/e/uc/7937bc6ebae24cc8bc94208dc2d041c8?utm_campaign=embed&utm_source=other&autoplay-annotations=true"
            allowfullscreen="allowfullscreen"
            loading="lazy"
            title="Visita Virtual 360° Daikan Dojo"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
          ></iframe>
          <div class="viewer-360__fallback" style="display: none;">
            <p>⚠️ La visita virtual no está disponible temporalmente.</p>
            <p>
              Por favor, visítanos en persona o contáctanos para más
              información.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios Section -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="section-header__subtitle">¿Por qué artes marciales?</span>
        <h2 class="section-header__title">Beneficios para tu vida</h2>
        <div class="divider divider--center"></div>
      </div>

      <div class="grid grid--4 benefits-grid">
        <div
          class="feature"
          style="background-image: url('/images/beneficios/saludable.jpeg')"
          role="img"
          aria-label="Practicante realizando actividad saludable en artes marciales"
        >
          <div class="feature__content">
            <h3 class="feature__title">Actividad Saludable</h3>
            <p class="feature__text">
              Tonificación muscular, mejora de la psicomotricidad y desarrollo
              mental. Beneficios innumerables para tu salud física y emocional.
            </p>
          </div>
        </div>

        <div
          class="feature"
          style="background-image: url('/images/beneficios/defensaPersonal.jpeg')"
          role="img"
          aria-label="Entrenamiento de defensa personal en Daikan Dojo"
        >
          <div class="feature__content">
            <h3 class="feature__title">Defensa Personal</h3>
            <p class="feature__text">
              Aprende a protegerte y a defender a los tuyos. Desarrolla la
              confianza y la seguridad en ti mismo.
            </p>
          </div>
        </div>

        <div
          class="feature"
          style="background-image: url('/images/beneficios/Edades.jpeg')"
          role="img"
          aria-label="Clases de artes marciales para todas las edades"
        >
          <div class="feature__content">
            <h3 class="feature__title">Para Todas las Edades</h3>
            <p class="feature__text">
              Desde los más jóvenes hasta adultos. Karate, Judo, Aikido Tomiki y
              muchas más disciplinas adaptadas a cada nivel.
            </p>
          </div>
        </div>

        <div
          class="feature"
          style="background-image: url('/images/beneficios/equipo.jpeg')"
          role="img"
          aria-label="Espíritu de equipo y compañerismo en Daikan Dojo"
        >
          <div class="feature__content">
            <h3 class="feature__title">Espíritu de Equipo</h3>
            <p class="feature__text">
              Las artes marciales fortalecen las relaciones sociales. Forma
              parte de nuestra Asociación Daikan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Historia Section -->
  <section class="section">
    <div class="container">
      <div class="history-grid">
        <div class="history-content">
          <span class="section-header__subtitle">Nuestra historia</span>
          <h2>Asociación Centro Deportivo Daikan Dojo</h2>
          <div class="divider"></div>
          <p>
            «La historia de Daikan Dojo podría ser el argumento perfecto de una
            película. Detrás de este proyecto hay mucha pasión y mucha
            experiencia. Los amantes de los deportes de contacto cuentan con un
            templo en el que, además de los mejores maestros y las mejores
            instalaciones, encontrarán una familia.»
          </p>
          <p class="history-quote">— Francisco Daniel Medina, Staf Magazine</p>

          <p>
            El significado del nombre <strong>"DAIKAN"</strong> es "Gran Edificio
            o espacio" aplicado sobre todo a elementos sagrados y <strong
              >"DOJO"</strong
            > es el lugar donde tradicionalmente se reunían los samuráis para sus
            entrenamientos.
          </p>

          <a href="/asociacion" class="btn btn--primary">
            Conoce nuestra historia →
          </a>
        </div>
        <div class="history-image">
          <div class="history-image__placeholder">
            <img
              src="/images/recursos/logoRojoDaikan.png"
              alt="Logo de Daikan Dojo - Escuela de Artes Marciales en Málaga"
              class="history-logo"
              width="280"
              height="280"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .section-disciplinas {
    position: relative;
    height: 100vh;
    /* Usamos el mismo fondo que el Hero con attachment fixed para dar el efecto de continuidad/transparencia */
    background-image: url("/images/recursos/fondoCirculoRojoAlto.svg");
    background-size: cover;
    background-position: top;
    background-attachment: fixed;
    background-repeat: no-repeat;

    padding-bottom: 5vh;
    z-index: 5;
  }

  .btn-disciplinas {
    text-decoration: none;
    color: inherit;
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
  }

  .btn-disciplinas:hover {
    transform: scale(1.2);
  }

  .btn-disciplinas:hover .section-header__title {
    color: var(--color-accent);
  }

  .btn-disciplinas:active {
    transform: scale(0.95);
  }

  .section-disciplinas .container {
    background: transparent;
    height: 100%;
    position: relative; /* Para los botones absolutos si se desea referenciar al container */
    display: flex;
    flex-direction: column;
  }
  /* Carousel Styles */
  .carousel-wrapper {
    position: relative;
    padding: 0; /* Eliminamos padding para que los botones floten sobre el contenido */
    max-width: 100%;
    flex: 1; /* Ocupar el espacio restante despues del header */
    min-height: 0; /* Importante para que flexbox no desborde en firefox/otros */
    overflow: hidden; /* Asegurar que no exceda el viewport */
  }

  .carousel-track-container {
    overflow: hidden;
    width: 100%;
    height: 100%;
  }

  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    /* Mobile: 3 filas */
    grid-template-rows: repeat(3, 1fr);
    /* Mobile: 1 columna visible (100%) */
    grid-auto-columns: 100%;

    column-gap: 0;
    row-gap: 0;
    padding: 0; /* Espacio lateral para no cortar contenido bajo botones */
    transition: transform 0.5s ease-in-out;
    list-style: none;
    margin: 0;
    height: 100%;
  }

  @media (min-width: 768px) {
    .carousel-track {
      /* Desktop: 2 filas */
      grid-template-rows: repeat(2, 1fr);
      /* Desktop: 3 columnas visibles (33.333%) */
      grid-auto-columns: calc((100% / 3) - (var(--space-6) * 2 / 3));
      gap: var(--space-6);
    }
  }

  .carousel-slide {
    height: 100%;
    max-width: 100%;
    padding: 2%;
    /* Flex rules removed, handled by grid */
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(15, 15, 15, 0.6);
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 20;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    backdrop-filter: blur(4px);
  }

  .carousel-btn:hover {
    background: rgba(200, 30, 58, 0.8);
    transform: translateY(-50%) scale(1.1);
    border-color: var(--color-primary);
  }

  .carousel-btn--prev {
    left: 10px;
  }

  .carousel-btn--next {
    right: 10px;
  }

  .carousel-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .benefits-grid {
    margin-top: var(--space-8);
  }

  .feature {
    background-color: #202020;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 50vh;
    position: relative;
    border: 0px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: center;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  .feature::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.9) 100%
    );
    z-index: -1;
    transition: all 0.3s ease;
  }

  .feature__content {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    padding: 0 var(--space-4);
    transform: translateY(-50%);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .feature:hover .feature__content,
  .feature.is-focused .feature__content {
    top: var(--space-6);
    transform: translateY(0);
  }

  .feature:hover,
  .feature.is-focused {
    transform: translateY(-5px);
    border-color: var(--color-primary);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9);
  }

  .feature:hover::before,
  .feature.is-focused::before {
    background: linear-gradient(
      180deg,
      rgba(20, 20, 20, 0.6) 0%,
      rgba(10, 10, 10, 0.1) 100%
    );
  }

  .feature__icon {
    font-size: 3rem;
    margin-bottom: var(--space-4);
    display: block;
  }

  .feature__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }

  .feature__text {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .history-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .history-content h2 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-4);
  }

  .history-content p {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-4);
  }

  .history-quote {
    color: var(--color-accent);
    font-style: italic;
    font-weight: var(--font-weight-medium);
  }

  .history-content .btn {
    margin-top: var(--space-6);
  }

  .history-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .history-image__placeholder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    background: var(--gradient-hero);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .history-image__placeholder .history-logo {
    width: 280px;
    height: auto;
    object-fit: contain;
  }

  /* Mejorar legibilidad en móvil para sección de asociación */
  @media (max-width: 768px) {
    #mobile-fixed-bg {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      z-index: 0;
      background-image: url("/images/recursos/fondoMovil.svg");
      background-size: cover;
      background-position: top center;
      background-repeat: no-repeat;
    }

    .section-disciplinas {
      background: transparent !important;
      background-image: none !important;
      position: relative;
      z-index: 5;
    }

    /* Hero transparent on mobile to show fixed bg */
    :global(.hero) {
      background: transparent !important;
      position: relative;
      z-index: 1;
    }

    :global(.hero__layer-base) {
      display: none !important; /* Hide hero base layer on mobile */
    }

    /* Ensure other sections cover the fixed background */
    .section,
    .viewer-section {
      position: relative;
      z-index: 1;
      background-color: var(--color-bg);
    }

    .history-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .history-content h2 {
      font-size: var(--font-size-2xl); /* Más legible en móvil */
      line-height: 1.3;
      margin-bottom: var(--space-4);
    }

    .history-content p {
      font-size: var(--font-size-lg); /* Mantener tamaño grande */
      line-height: 1.8; /* Más espacio entre líneas */
      margin-bottom: var(--space-5);
    }

    .history-quote {
      font-size: var(--font-size-base);
      margin-bottom: var(--space-6);
    }

    .history-image__placeholder {
      max-width: 300px;
    }

    .history-image__placeholder .history-logo {
      width: 220px;
    }
  }

  /* 3D VIEWER SECTION */
  .viewer-section {
    padding: var(--space-20) 0;
    background: var(--gradient-hero);
    overflow: hidden;
  }

  .viewer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .viewer-content h2 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-4);
  }

  .viewer-content h2 span {
    color: var(--color-accent);
  }

  .viewer-content p {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-6);
  }

  .viewer-360 {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.1);
    margin: 0 auto;
  }

  .viewer-360 iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .viewer-360__fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: var(--space-8);
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-lg);
  }

  .viewer-360__fallback p {
    color: var(--color-text-muted);
    margin: var(--space-2) 0;
  }

  @media (max-width: 1024px) {
    .viewer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .viewer-360 {
      order: -1;
      max-width: 100%;
    }

    .viewer-content {
      text-align: center;
    }

    .mini-cube-container {
      margin: 0 auto var(--space-4);
    }
  }

  /* CUBE 3D */
  .mini-cube-container {
    width: 150px;
    height: 150px;
    perspective: 400px;
    margin: var(--space-6) auto;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .mini-cube-container:active {
    cursor: grabbing;
  }

  .mini-cube {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(-15deg) rotateY(25deg);
    animation: miniCubeRotate 15s infinite linear;
    transition: transform 0.1s ease-out;
  }

  .mini-cube-container:hover .mini-cube {
    animation-play-state: paused;
  }

  @keyframes miniCubeRotate {
    from {
      transform: rotateX(-15deg) rotateY(0deg);
    }
    to {
      transform: rotateX(-15deg) rotateY(360deg);
    }
  }

  .mini-cube__face {
    position: absolute;
    width: 100px;
    height: 100px;
    left: 25px;
    top: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: bold;
    color: var(--color-primary);
    background: transparent;
    border: 2px solid var(--color-primary);
    backface-visibility: visible;
  }

  .mini-cube__face--front {
    transform: rotateY(0deg) translateZ(50px);
  }
  .mini-cube__face--back {
    transform: rotateY(180deg) translateZ(50px);
  }
  .mini-cube__face--right {
    transform: rotateY(90deg) translateZ(50px);
  }
  .mini-cube__face--left {
    transform: rotateY(-90deg) translateZ(50px);
  }
  .mini-cube__face--top {
    transform: rotateX(90deg) translateZ(50px);
  }
  .mini-cube__face--bottom {
    transform: rotateX(-90deg) translateZ(50px);
  }
</style>

<script is:inline src="/scripts/cube3d.js"></script>
<script is:inline src="/scripts/benefits-observer.js"></script>
<script is:inline src="/scripts/carousel.js"></script>

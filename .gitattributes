# Normalizar saltos de línea a LF en el repositorio para todos los archivos de texto
* text=auto eol=lf

# Archivos de texto explícitos: siempre LF
*.js        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.astro     text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf -diff

# Archivos de scripts: LF obligatorio (rompen con CRLF en Linux/macOS)
*.sh        text eol=lf
*.bash      text eol=lf

# Scripts de Windows: CRLF (se usan sólo en Windows)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Archivos binarios: sin conversión
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.zip       binary
*.tar.gz    binary
